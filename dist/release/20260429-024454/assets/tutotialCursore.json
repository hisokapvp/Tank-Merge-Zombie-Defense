{
  "atlas": "assets/tutorial_cursor_atlas.svg",
  "animations": {
    "click": {
      "x": 0,
      "y": 0,
      "w": 32,
      "h": 32,
      "frames": 2,
      "frameRateFps": 4,
      "loop": true,
      "scale": 1
    },
    "drag": {
      "x": 64,
      "y": 0,
      "w": 32,
      "h": 32,
      "frames": 2,
      "frameRateFps": 6,
      "loop": true,
      "scale": 1
    },
    "drop": {
      "x": 128,
      "y": 0,
      "w": 32,
      "h": 32,
      "frames": 2,
      "frameRateFps": 5,
      "loop": true,
      "scale": 1
    }
  },
  "steps": {
    "starter_tank": {
      "spriteRotationDeg": 90,
      "motionAngleDeg": 0,
      "offset": { "x": -50, "y": 10 }
    },
    "second_tank": {
      "spriteRotationDeg": 0,
      "motionAngleDeg": 0,
      "offset": { "x": 0, "y": 0 }
    },
    "merge_tank": {
      "spriteRotationDeg": 90,
      "motionAngleDeg": 0,
      "offset": { "x": 0, "y": 0 }
    }
  }
}
