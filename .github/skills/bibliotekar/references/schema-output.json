{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill",
    "version",
    "repo",
    "tooling",
    "shared",
    "items"
  ],
  "properties": {
    "skill": {
      "type": "string",
      "enum": [
        "Библиотекарь"
      ]
    },
    "version": {
      "type": "string",
      "enum": [
        "1.1"
      ]
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "localPath": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "localPath"
          ]
        },
        {
          "required": [
            "url",
            "localPath"
          ]
        }
      ]
    },
    "tooling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directives",
        "recommended"
      ],
      "properties": {
        "directives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommended": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "file_tree",
              "text_search",
              "open_file",
              "context7"
            ]
          }
        }
      }
    },
    "shared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "file",
              "anchor",
              "hints",
              "conf",
              "why"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^S[0-9]{1,3}$"
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "anchor": {
                "type": "string",
                "minLength": 1
              },
              "hints": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "conf": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "why": {
                "type": "string",
                "enum": [
                  "DIRECT_FILE_MENTION",
                  "REPO_ENTRYPOINT",
                  "KEYWORD_HEURISTIC",
                  "STRING_LITERAL_SEARCH",
                  "CROSS_CUTTING_CONCERN"
                ]
              },
              "risk": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "string",
                  "enum": [
                    "carefulRemoval",
                    "uiRegression",
                    "saveCompat",
                    "perfRisk",
                    "logicCoupling"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 120,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "summary",
          "targets"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ref"
                  ],
                  "properties": {
                    "ref": {
                      "type": "string",
                      "pattern": "^S[0-9]{1,3}$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "file",
                    "anchor",
                    "hints",
                    "conf",
                    "why"
                  ],
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1
                    },
                    "anchor": {
                      "type": "string",
                      "minLength": 1
                    },
                    "hints": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 6,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "conf": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "why": {
                      "type": "string",
                      "enum": [
                        "DIRECT_FILE_MENTION",
                        "REPO_ENTRYPOINT",
                        "KEYWORD_HEURISTIC",
                        "STRING_LITERAL_SEARCH",
                        "CROSS_CUTTING_CONCERN"
                      ]
                    },
                    "risk": {
                      "type": "array",
                      "maxItems": 6,
                      "items": {
                        "type": "string",
                        "enum": [
                          "carefulRemoval",
                          "uiRegression",
                          "saveCompat",
                          "perfRisk",
                          "logicCoupling"
                        ]
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}