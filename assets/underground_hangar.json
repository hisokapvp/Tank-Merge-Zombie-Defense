    "hover_end":   { "x": 512, "y": 0, "w": 64, "h": 64, "frames": 4, "frameRateFps": 10, "loop": false },
    "click":       { "x": 768, "y": 0, "w": 64, "h": 64, "frames": 3, "frameRateFps": 10, "loop": false },
    "close":       { "x": 960, "y": 0, "w": 64, "h": 64, "frames": 3, "frameRateFps": 10, "loop": false }
  }
