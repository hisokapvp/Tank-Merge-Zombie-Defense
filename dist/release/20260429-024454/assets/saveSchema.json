{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tank-merge-zombie-defense.local/schemas/save.schema.json",
  "title": "TMZD Serialized Save Payload",
  "description": "Machine-readable schema for src/persistence/storage.js serializeState() output (SAVE_VERSION=2). Mirrors the JSDoc typedefs in src/persistence/serializedStateTypes.js and the Payload Contract Map in docs/ai/SYSTEMS/save.md. Loader is preserve-unknown=false; legacy saves with missing fields rely on restore defaults (see P4.7/P4.8).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "coins",
    "kills",
    "fenceLevel",
    "cells",
    "supercomputer",
    "player",
    "buyCounts",
    "buyPrices",
    "achievements",
    "stats"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Canonical SAVE_VERSION. Current writer emits 2."
    },
    "coins": { "type": "number", "minimum": 0 },
    "kills": { "type": "integer", "minimum": 0 },
    "tutorial": { "type": ["object", "null"] },
    "totalDamageDealtRaw": { "type": "number", "minimum": 0 },
    "zombieWaveAtkMult": { "type": "number", "minimum": 0 },
    "damagePointsSpent": { "type": "integer", "minimum": 0 },
    "fenceLevel": { "type": "integer", "minimum": 1 },
    "fenceRepairCount": { "type": "integer", "minimum": 0 },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["i"],
        "additionalProperties": true,
        "properties": {
          "i": { "type": "integer", "minimum": 0 },
          "orbitPhase": { "type": ["number", "null"] },
          "tank": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["id", "level"],
                "additionalProperties": true,
                "properties": {
                  "id": { "type": "string", "pattern": "^tank_lvl[0-9]+$" },
                  "level": { "type": "integer", "minimum": 1, "maximum": 60 },
                  "onTrack": { "type": "boolean" },
                  "powerTier": {}
                }
              }
            ]
          }
        }
      }
    },
    "supercomputer": { "type": "object", "additionalProperties": true },
    "player": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "damagePoints": { "type": "integer", "minimum": 0 },
        "talentsV2": { "type": "object", "additionalProperties": true },
        "freeTalentPointsV2": { "type": "integer", "minimum": 0 }
      }
    },
    "buyCounts": { "type": "object", "additionalProperties": { "type": "number" } },
    "buyPrices": { "type": "object", "additionalProperties": { "type": "number" } },
    "crate": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["cellIndex", "rewardLevel"],
          "additionalProperties": true,
          "properties": {
            "cellIndex": { "type": "integer", "minimum": 0 },
            "rewardLevel": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "nextCrateAt": { "type": "number" },
    "maxTankLevelAchieved": { "type": "integer", "minimum": 1, "maximum": 60 },
    "boostUntil": { "type": "number" },
    "activeEffects": { "type": "array" },
    "fenceState": {
      "type": "object",
      "required": ["hpById"],
      "additionalProperties": true,
      "properties": {
        "segmentsPerSide": { "type": ["integer", "null"], "minimum": 0 },
        "hpById": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        }
      }
    },
    "achievements": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "unlocked":  { "type": "object", "additionalProperties": { "type": "boolean" } },
        "rewarded":  { "type": "object", "additionalProperties": { "type": "boolean" } },
        "popupQueue": { "type": "array" },
        "totalManualFenceRepairs":      { "type": "integer", "minimum": 0 },
        "totalModifierTechUnlocks":     { "type": "integer", "minimum": 0 },
        "totalDroneAcquisitions":       { "type": "integer", "minimum": 0 },
        "totalNoRepairAttackWaveStreak": { "type": "integer", "minimum": 0 }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "tanksMergedCount":               { "type": "integer", "minimum": 0 },
        "tanksBoughtCount":               { "type": "integer", "minimum": 0 },
        "manualFenceRepairsCount":        { "type": "integer", "minimum": 0 },
        "modifierTechUnlocksCount":       { "type": "integer", "minimum": 0 },
        "droneAcquisitionsCount":         { "type": "integer", "minimum": 0 },
        "noRepairAttackWaveStreakCount":  { "type": "integer", "minimum": 0 }
      }
    },
    "mapSeeds": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "stampsSeed": { "type": "number" },
            "decorSeed":  { "type": "number" }
          }
        }
      ]
    },
    "drones": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "lastSeenAt": { "type": "number" }
  }
}
