{
  "name": "tmzd-packaging",
  "private": true,
  "version": "1.0.0",
  "description": "Native packaging toolchain (Electron/Steam desktop) for Tank Merge Zombie Defense. Lives OUTSIDE the game web bundle — never shipped to web/Yandex. The game runtime itself remains pure HTML5 Canvas + Phaser with no npm/build step.",
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "build:web": "node scripts/build-web-bundle.mjs",
    "start": "npm run build:web && electron electron/main.js",
    "build:desktop": "npm run build:web && electron-builder --config electron/electron-builder.yml",
    "build:win": "npm run build:web && electron-builder --config electron/electron-builder.yml --win",
    "build:mac": "npm run build:web && electron-builder --config electron/electron-builder.yml --mac",
    "build:linux": "npm run build:web && electron-builder --config electron/electron-builder.yml --linux",
    "cap:add:android": "cap add android --config capacitor/capacitor.config.ts",
    "cap:add:ios": "cap add ios --config capacitor/capacitor.config.ts",
    "cap:sync": "cap sync --config capacitor/capacitor.config.ts",
    "build:android": "node scripts/build-android.mjs",
    "build:ios": "node scripts/build-ios.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/ios": "^6.1.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@revenuecat/purchases-capacitor": "^8.0.0",
    "steamworks.js": "^0.4.0"
  }
}
